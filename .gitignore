# build
dist/
# estado local de miniflare/workerd que genera el adaptador de Cloudflare.
# Son sqlite de varios MB y no son del sitio: en una rama anterior se colaron
# al repositorio y hubo que sacarlos.
.wrangler/
.astro/
.output/
.vercel/
.netlify/

# deps
node_modules/

# fuentes copiadas por scripts/fonts.mjs — se regeneran en postinstall
public/fonts/*.woff2
public/fonts/*LICENSE*

# entorno
.env
.env.local
.env.production
!.env.example

# sistema
.DS_Store
Thumbs.db
*.log
npm-debug.log*

# herramientas del agente, no del sitio
# Eran 360 de los 454 archivos del repo, y .claude/skills y .agents/skills
# guardaban dos copias exactas de lo mismo. Los archivos siguen en disco;
# solo dejan de viajar en el repo. Se recuperan con `npx skills`.
.claude/skills/
.agents/
skills-lock.json

# material de origen del vídeo del hero: el archivo servido es
# public/video/hero.mp4, generado por scripts/hero-video.mjs
/*.mp4
