---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import FeaturedArticle from '../../components/FeaturedArticle.astro';
import ArticleCard from '../../components/ArticleCard.astro';
import NewsroomFilter from '../../components/NewsroomFilter.astro';
import { splitFeatured, byDateDesc, published } from '../../lib/newsroom';

const all = byDateDesc(published(await getCollection('newsroom')));
const { featured } = splitFeatured(all, 0);
const rest = all.filter((e) => e.id !== featured?.id);

/** Claro, medio, tinta, y vuelta a empezar. */
const TONES = ['paper', 'moss', 'ink'] as const;

const title = 'Newsroom';
const description =
  'Publicaciones, anuncios, prensa y actualidad de WR AI Labs. Método, resultados, y las normas y estudios sobre inteligencia artificial que tocan nuestro trabajo.';
---

<Base title={title} description={description}>
  <section class="section page-head" data-surface="dark">
    <div class="container">
      <p class="t-eyebrow">{title}</p>
      <h1 class="t-h1 page-head__title" data-text-reveal>
        Publicamos el método antes de que nos lo pidan.
      </h1>
    </div>
  </section>

  <section class="section" aria-label="Artículos">
    <div class="container">
      {featured && <FeaturedArticle entry={featured} as="h2" />}

      {/*
        El filtro cuenta `rest`, no `all`: el destacado vive fuera de la lista
        y no se filtra, así que incluirlo en el recuento daría un número que
        no casa con lo que se ve.
      */}
      {rest.length > 0 && <NewsroomFilter total={rest.length} />}

      {
        rest.length > 0 ? (
          <ul class="cards" role="list" data-articles>
            {rest.map((entry, i) => (
              <ArticleCard
                entry={entry}
                tone={TONES[i % TONES.length]}
                delay={Math.min(i, 3) * 100}
              />
            ))}
          </ul>
        ) : (
          !featured && <p class="t-body empty">Todavía no hay publicaciones.</p>
        )
      }

      <p class="t-body empty" data-empty hidden>
        No hay publicaciones en esta categoría.
      </p>
    </div>
  </section>
</Base>

<style>
  .page-head {
    padding-top: calc(var(--header-h) + var(--space-2xl));
  }

  .page-head__title {
    margin-top: var(--space-s);
    max-width: 18ch;
  }

  .cards {
    display: grid;
    gap: var(--gutter);
    /* El filtro ya pone el aire por encima con su filete. */
    margin: var(--space-l) 0 0;
    padding: 0;
    /* El color con el que las tarjetas muerden su esquina: el de esta página,
       no el de la tarjeta, que redefine --surface con su tono. */
    --notch: var(--surface);
  }

  @media (min-width: 48rem) {
    .cards {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  .empty {
    color: var(--text-muted);
  }
</style>
