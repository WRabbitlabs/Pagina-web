---
import { getCollection, render } from 'astro:content';
import { Picture } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import Arrow from '../../components/Arrow.astro';
import ArticleCard from '../../components/ArticleCard.astro';
import { byDateDesc, published, formatDate, isoDate } from '../../lib/newsroom';
import { site } from '../../data/site';

export async function getStaticPaths() {
  const entries = await getCollection('newsroom');
  // Los que viven fuera del sitio no generan página propia.
  return entries
    .filter((e) => !e.data.externalUrl)
    .map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

/** Claro, medio, tinta, y vuelta a empezar. */
const TONES = ['paper', 'deep', 'ink'] as const;

const { entry } = Astro.props;
const { Content } = await render(entry);
const { title, category, date, excerpt, image, imageAlt, imageCredit, source } = entry.data;

const more = byDateDesc(published(await getCollection('newsroom')))
  .filter((e) => e.id !== entry.id)
  .slice(0, 3);

const article = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: title,
  description: excerpt,
  datePublished: date.toISOString(),
  dateModified: date.toISOString(),
  inLanguage: 'es-CO',
  articleSection: category,
  ...(source ? { citation: source.href } : {}),
  mainEntityOfPage: {
    '@type': 'WebPage',
    '@id': new URL(`/newsroom/${entry.id}`, site.url).href,
  },
  author: { '@type': 'Organization', name: site.name, url: site.url },
  publisher: {
    '@type': 'Organization',
    name: site.name,
    logo: { '@type': 'ImageObject', url: new URL('/icon-512.png', site.url).href },
  },
};
---

{/*
  Sin `ogImage`: los articulos usan la tarjeta por defecto.

  Se intento darle a cada uno la suya con `image.src`, y fue un error: esa
  ruta no la emite el pipeline de assets —Astro solo escribe las variantes
  que genera <Picture>— asi que las cuatro og:image devolvian 404. Y aunque
  existieran, pesan de 400 KB a 2,2 MB: WhatsApp descarta la vista previa
  por encima de 300 KB y deja el enlace pelado.

  Para volver a intentarlo hace falta generar una tarjeta de 1200x630 por
  articulo, como hace scripts/og.mjs con la de por defecto.
*/}
<Base title={title} description={excerpt} ogType="article" jsonLd={[article]}>
  {/*
    Barra de progreso de lectura. Sin una línea de JavaScript: la anima el
    propio scroll con `animation-timeline`, así que corre en el compositor y
    no despierta al hilo principal en cada fotograma.

    Decorativa por completo —`aria-hidden`—: no aporta nada que el texto no
    diga, y anunciar un porcentaje de avance a un lector de pantalla es ruido.
  */}
  <div class="progress" aria-hidden="true"></div>

  <article class="article">
    <header class="section article__head" data-surface="dark">
      <div class="container">
        <p class="t-eyebrow article__meta">
          <span class="article__dot" aria-hidden="true"></span>
          {category}
          <span aria-hidden="true"> · </span>
          <time datetime={isoDate(date)}>{formatDate(date)}</time>
        </p>

        <h1 class="t-h1 article__title">{title}</h1>
        <p class="t-lead article__excerpt">{excerpt}</p>
      </div>
    </header>

    {
      image && (
        <figure class="container article__media">
          <Picture
            src={image}
            formats={['avif', 'webp']}
            widths={[640, 960, 1280, 1600]}
            sizes="(min-width: 64rem) 70vw, 92vw"
            alt={imageAlt ?? ''}
            loading="eager"
            fetchpriority="high"
            decoding="async"
            class="article__img"
          />

          {/* CC-BY exige credito visible mientras la foto siga publicada. */}
          {imageCredit && (
            <figcaption class="t-eyebrow article__credit">
              <a
                class="article__creditlink external"
                href={imageCredit.href}
                target="_blank"
                rel="noopener noreferrer license"
              >
                {imageCredit.text}
                <span class="sr-only"> (se abre en una pestaña nueva)</span>
              </a>
            </figcaption>
          )}
        </figure>
      )
    }

    <div class="section section--tight">
      <div class="container">
        <div class="prose article__body">
          <Content />
        </div>

        {/* La fuente de una pieza de actualidad, con el mismo tratamiento de
            enlace externo que el crédito de la foto. */}
        {
          source && (
            <p class="t-eyebrow article__source">
              Fuente:{' '}
              <a
                class="article__creditlink external"
                href={source.href}
                target="_blank"
                rel="noopener noreferrer"
              >
                {source.text}
                <span class="sr-only"> (se abre en una pestaña nueva)</span>
              </a>
            </p>
          )
        }
      </div>
    </div>
  </article>

  {
    more.length > 0 && (
      <section class="section" data-surface="frost" aria-labelledby="more">
        <div class="container">
          <div class="more__head">
            <h2 class="t-h3" id="more">Seguir leyendo</h2>
            <a class="link-arrow" href="/newsroom">
              Ver todo
              <Arrow />
            </a>
          </div>
          <ul class="more__list" role="list">
            {more.map((e, i) => (
              <ArticleCard entry={e} tone={TONES[i % TONES.length]} delay={i * 100} />
            ))}
          </ul>
        </div>
      </section>
    )
  }
</Base>

<style>
  .article__head {
    padding-top: calc(var(--header-h) + var(--space-xl));
  }

  .article__meta {
    display: flex;
    align-items: center;
    gap: 0.4ch;
  }

  .article__dot {
    width: 6px;
    height: 6px;
    margin-right: 0.4ch;
    background: var(--signal);
    border-radius: 50%;
    flex: none;
  }

  .article__title {
    margin-top: var(--space-s);
    max-width: 22ch;
  }

  .article__excerpt {
    margin-top: var(--space-m);
    max-width: var(--measure);
  }

  /* --------------------------------------------------------------------- */
  /* Progreso de lectura                                                    */
  /* --------------------------------------------------------------------- */

  .progress {
    position: fixed;
    inset: 0 0 auto;
    z-index: 60;
    height: 2px;
    background: var(--signal);
    transform: scaleX(0);
    transform-origin: 0 50%;
    /*
     * Sin soporte de `animation-timeline` la barra se queda en scaleX(0), o
     * sea invisible, que es exactamente la degradación que se quiere: la
     * página no pierde nada, solo el indicador.
     */
    animation: read-progress linear both;
    animation-timeline: scroll(root block);
  }

  @keyframes read-progress {
    to {
      transform: scaleX(1);
    }
  }

  /*
   * La lima aquí no es un fondo: es la ración de acento marcando el estado
   * vivo, el mismo papel que cumple en el punto de 6px de las etiquetas y en
   * el nodo final del Trazado. Dos píxeles de alto son un filete, no una
   * superficie.
   */

  .article__media {
    margin-top: var(--space-xl);
  }

  .article__credit {
    margin-top: var(--space-2xs);
    color: var(--text-muted);
  }

  .article__creditlink {
    text-decoration: underline;
    text-underline-offset: 0.18em;
    text-decoration-thickness: 1px;
    text-decoration-color: var(--rule);
    transition: text-decoration-color var(--dur-fast) var(--ease-out);
  }

  .article__creditlink:hover {
    text-decoration-color: currentColor;
  }

  .article__source {
    max-width: 62ch;
    margin-top: var(--space-l);
    padding-top: var(--space-s);
    border-top: 1px solid var(--rule);
    color: var(--text-muted);
    line-height: 1.6;
  }

  .article__img {
    width: 100%;
    height: auto;
    border-radius: var(--radius-img);
  }

  /* El cuerpo del artículo hereda .prose: medida 62ch, line-height 1.6. */
  .article__body :global(h2) {
    margin-top: 2em;
    font-size: var(--text-h3);
    line-height: var(--lh-h3);
    letter-spacing: var(--ls-heading);
    color: var(--text);
  }

  .article__body :global(h3) {
    margin-top: 1.8em;
    font-size: var(--text-lead);
    line-height: var(--lh-lead);
    color: var(--text);
  }

  .more__head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-xs);
  }

  .more__list {
    display: grid;
    gap: var(--gutter);
    margin: var(--space-m) 0 0;
    padding: 0;
    /* Ver ArticleCard: la muesca se pinta con el fondo de la sección. */
    --notch: var(--surface);
  }

  @media (min-width: 48rem) {
    .more__list {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
</style>
