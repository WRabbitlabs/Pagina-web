---
import Base from '../layouts/Base.astro';
import Hero from '../components/home/Hero.astro';
import Stage from '../components/home/Stage.astro';
import Statements from '../components/home/Statements.astro';
import Story from '../components/Story.astro';
import Gap from '../components/home/Gap.astro';
import Platform from '../components/home/Platform.astro';
import Governance from '../components/home/Governance.astro';
import Method from '../components/Method.astro';
import Marquee from '../components/home/Marquee.astro';
import Results from '../components/home/Results.astro';
import Company from '../components/home/Company.astro';
import NewsroomTeaser from '../components/home/NewsroomTeaser.astro';
import { site, social } from '../data/site';
import { hero } from '../data/home';

const organization = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: site.name,
  legalName: site.legalName,
  url: site.url,
  logo: new URL('/icon-512.png', site.url).href,
  description: site.description,
  email: site.email,
  telephone: site.phone,
  foundingDate: site.founded,
  address: {
    '@type': 'PostalAddress',
    streetAddress: site.address.street,
    addressLocality: site.address.city,
    addressRegion: site.address.region,
    addressCountry: site.address.country,
  },
  sameAs: social.map((s) => s.href),
};

const website = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: site.name,
  url: site.url,
  inLanguage: 'es-CO',
  publisher: { '@type': 'Organization', name: site.name },
};
---

<Base
  title={`${site.name} — ${hero.headlineFlat}`}
  description={site.description}
  isHome
  jsonLd={[organization, website]}
>
  <!--
    Hero y declaraciones comparten un único fondo de vídeo fijado. El marco se
    abre al cargar y se suelta a sangre completa al bajar. Ver Stage.astro.
  -->
  <Stage>
    <Hero />
    <Statements />
  </Stage>

  {/*
    Orden de lectura: de dónde venimos → qué problema hay → qué hacemos →
    cómo se contrata → cómo se opera → la prueba → quiénes somos.

    La historia abre porque explica el nombre y el oficio antes de pedir nada,
    y porque la brecha se entiende mejor sabiendo que llevamos doscientos años
    tejiendo instrucciones. El método va pegado a la plataforma: primero qué
    es, después cómo se contrata. La evidencia va tras el respiro del marquee,
    para que las cifras no lleguen pegadas a la consola.
  */}
  <Story />
  <Gap />
  <Platform />
  <Method />
  <Governance />
  <Marquee />
  <Results />
  <Company />
  <NewsroomTeaser />
</Base>

