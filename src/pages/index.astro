---
import Base from '../layouts/Base.astro';
import Hero from '../components/home/Hero.astro';
import Stage from '../components/home/Stage.astro';
import Statements from '../components/home/Statements.astro';
import Story from '../components/Story.astro';
import Platform from '../components/home/Platform.astro';
import Governance from '../components/home/Governance.astro';
import Method from '../components/Method.astro';
import Marquee from '../components/home/Marquee.astro';
import Company from '../components/home/Company.astro';
import NewsroomTeaser from '../components/home/NewsroomTeaser.astro';
import { site, social } from '../data/site';
import { hero } from '../data/home';

const organization = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: site.name,
  legalName: site.legalName,
  url: site.url,
  logo: new URL('/icon-512.png', site.url).href,
  description: site.description,
  email: site.email,
  telephone: site.phone,
  foundingDate: site.founded,
  address: {
    '@type': 'PostalAddress',
    streetAddress: site.address.street,
    addressLocality: site.address.city,
    addressRegion: site.address.region,
    addressCountry: site.address.country,
  },
  sameAs: social.map((s) => s.href),
};

const website = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: site.name,
  url: site.url,
  inLanguage: 'es-CO',
  publisher: { '@type': 'Organization', name: site.name },
};
---

<Base
  title={`${site.name} — ${hero.headlineFlat}`}
  description={site.description}
  isHome
  jsonLd={[organization, website]}
>
  <!--
    Hero y declaraciones comparten un único fondo de vídeo fijado. El marco se
    abre al cargar y se suelta a sangre completa al bajar. Ver Stage.astro.
  -->
  <Stage>
    <Hero />
    <Statements />
  </Stage>

  {/*
    Orden de lectura, en la forma del sitio de referencia: quiénes somos →
    de dónde venimos → qué construimos → cómo se contrata → cómo se opera →
    respiro → la compañía → qué publicamos → el cierre, que vive en el pie.

    La historia abre porque explica el nombre y el oficio antes de pedir
    nada. El método va pegado a la plataforma: primero qué es, después cómo
    se contrata. El marquee separa la consola oscura de la compañía.

    Aquí no hay bloque de cifras ni bloque de problema: la página describe lo
    que hacemos y deja la prueba en el newsroom y en el equipo, que es como
    se sostiene la credibilidad sin autoproclamarse resultados.
  */}
  <Story />
  <Platform />
  <Method />
  <Governance />
  <Marquee />
  <Company />
  <NewsroomTeaser />
</Base>

