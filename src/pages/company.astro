---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import Cta from '../components/Cta.astro';
import Arrow from '../components/Arrow.astro';
import Method from '../components/Method.astro';
import PillarIcon from '../components/icons/PillarIcon.astro';
import { site } from '../data/site';
import { platform, company, closing } from '../data/home';
import { intro, team as teamCopy } from '../data/company';

const team = (await getCollection('team', ({ data }) => !data.draft)).sort(
  (a, b) => a.data.order - b.data.order,
);
const founders = team.filter((m) => m.data.founder);
const rest = team.filter((m) => !m.data.founder);

/*
 * Los rotulos de grupo solo valen cuando hay dos grupos que separar. Con una
 * sola ficha publicada, un titulo "Fundadores" sobre una tarjeta suelta anuncia
 * una lista que no existe; el h2 "Equipo" ya dice lo que hace falta.
 */
const showGroups = founders.length > 0 && rest.length > 0;

/*
 * El nombre de cada ficha cuelga del rotulo de grupo cuando lo hay. Sin
 * rotulo, ese h3 desaparece y la ficha tiene que ocupar su nivel: si no, la
 * pagina salta de h2 "Equipo" a h4 y deja un hueco en la jerarquia.
 */
const PersonName = showGroups ? 'h4' : 'h3';

const title = 'La compañía';
const description =
  'Quiénes somos, cómo trabajamos y por qué construimos automatización que deja evidencia. Historia, método, plataforma y equipo de WRabbit AI Labs.';
---

<Base title={title} description={description}>
  <section class="section page-head" data-surface="dark">
    <div class="container page-head__grid">
      <div>
        <p class="t-eyebrow">{intro.eyebrow}</p>
        {/* El titular de /company es el suyo: «IA aplicada, resultados
            medibles.» subio al hero de la portada y repetirlo aqui dejaria
            las dos paginas diciendo lo mismo en su H1. */}
        <h1 class="t-h1 page-head__title" data-text-reveal>{company.heading}</h1>

        {/*
          El lema va en inglés. `lang` propio para que un lector de pantalla
          en español no lo pronuncie como si fuera castellano.
        */}
        <p class="page-head__motto" lang="en">{intro.motto}</p>

        <p class="prose page-head__body" data-reveal>{intro.body}</p>

        {/*
          Una sola llamada fuerte por bloque: la segunda va como enlace con
          flecha. Dos botones del mismo peso compiten y no dirigen a nada.
        */}
        <p class="page-head__ctas" data-reveal>
          {
            intro.ctas.map((c) =>
              c.primary ? (
                <Cta label={c.label} href={c.href} />
              ) : (
                <a class="link-arrow" href={c.href}>
                  {c.label}
                  <Arrow />
                </a>
              ),
            )
          }
        </p>
      </div>

      {/*
        Dos de las cinco cifras de la portada, no unas nuevas: repetir la
        misma medición con otro número sería el modo más rápido de perder la
        credibilidad que la sección de evidencia construye.
      */}
      <ul class="figures" role="list" data-reveal>
        {
          intro.stats.map((s) => (
            <li class="figure">
              <p class="figure__n">
                {s.prefix && <span class="t-eyebrow figure__prefix">{s.prefix}</span>}
                {s.figure}
              </p>
              <p class="t-small figure__label">{s.label}</p>
              <p class="t-eyebrow figure__source">{intro.source}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="section" aria-labelledby="historia">
    <div class="container split">
      <div><h2 class="t-eyebrow" id="historia">Historia</h2></div>
      <div class="prose">
        {company.paragraphs.map((p) => <p set:html={p} />)}
        <p>
          Operamos desde {site.city}. Trabajamos por contrato directo y a través de
          convenios marco, y publicamos nuestro método en el
          <a href="/newsroom">newsroom</a> para que pueda revisarse antes de contratarnos.
        </p>
      </div>
    </div>
  </section>

  {/* El método completo. En la portada va la versión de una línea. */}
  <Method variant="full" headingLevel="h2" />

  <section class="section" id="plataforma" aria-labelledby="plataforma-title" data-surface="dark">
    <div class="container">
      <div class="split">
        <div><h2 class="t-eyebrow" id="plataforma-title">{platform.eyebrow}</h2></div>
        <div data-reveal>
          <p class="t-h2 lede" data-text-reveal>{platform.heading}</p>
          <p class="prose lede__body">{platform.body}</p>
        </div>
      </div>

      <ol class="pillars" role="list">
        {
          platform.pillars.map((p, i) => (
            <li class="pillar" data-reveal style={`--reveal-delay:${i * 100}ms`}>
              <p class="t-eyebrow pillar__n">{p.n}.</p>
              <p class="pillar__icon">
                <PillarIcon name={p.icon} />
              </p>
              <h3 class="t-h3 pillar__title">{p.title}</h3>
              <p class="t-body pillar__body">{p.body}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <section class="section" aria-labelledby="equipo">
    <div class="container">
      <div class="split">
        <div><h2 class="t-eyebrow" id="equipo">{teamCopy.eyebrow}</h2></div>
        <div>
          <p class="t-h2 lede">{teamCopy.lede}</p>
        </div>
      </div>

      {
        founders.length > 0 && (
          <>
            {showGroups && <h3 class="t-eyebrow group-title">Fundadores</h3>}
            <ul class="people" role="list">
              {founders.map((m, i) => (
                <li class="person" data-reveal style={`--reveal-delay:${i * 100}ms`}>
                  <PersonName class="t-h3">{m.data.name}</PersonName>
                  <p class="t-eyebrow person__role">{m.data.role}</p>
                  {m.data.links.map((l) => (
                    <a
                      class="link-arrow external person__link"
                      href={l.href}
                      target="_blank"
                      rel="noopener noreferrer"
                    >
                      {l.label}
                      <span class="sr-only"> de {m.data.name} (se abre en una pestaña nueva)</span>
                    </a>
                  ))}
                </li>
              ))}
            </ul>
          </>
        )
      }

      {
        rest.length > 0 && (
          <>
            {showGroups && <h3 class="t-eyebrow group-title">Dirección</h3>}
            <ul class="people" role="list">
              {rest.map((m, i) => (
                <li class="person" data-reveal style={`--reveal-delay:${i * 100}ms`}>
                  <PersonName class="t-h3">{m.data.name}</PersonName>
                  <p class="t-eyebrow person__role">{m.data.role}</p>
                </li>
              ))}
            </ul>
          </>
        )
      }
    </div>
  </section>

  <section class="section closing" data-surface="dark">
    <div class="container closing__inner" data-reveal>
      <p class="t-h2 closing__title" data-text-reveal>{closing.heading}</p>
      <p><Cta label={closing.cta.label} href={closing.cta.href} /></p>
    </div>
  </section>
</Base>

<style>
  /* Regla del sitio: una sección, una pantalla. El aire va en `svh` porque lo
     que desborda es el alto. Ver la nota larga de Gap.astro. */
  .page-head {
    --step: clamp(var(--space-2xs), 2.2svh, var(--space-s));

    padding-top: calc(var(--header-h) + clamp(var(--space-s), 6svh, var(--space-xl)));
    padding-bottom: clamp(var(--space-s), 7svh, var(--space-l));
  }

  .page-head__grid {
    display: grid;
    gap: var(--step) var(--gutter);
    align-items: end;
  }

  @media (min-width: 64rem) {
    .page-head__grid {
      grid-template-columns: minmax(0, 1.35fr) minmax(0, 1fr);
      gap: var(--space-xl);
    }
  }

  .page-head__title {
    font-size: min(var(--text-h1), 11svh);
    margin-top: var(--step);
    max-width: 14ch;
  }

  /*
   * El lema. Sin serif de imprenta: el sistema tiene una sola familia de texto
   * y meter otra por una línea costaría un archivo de fuente entero. Lo que lo
   * separa del cuerpo es el filete y la caja baja, no un tipo distinto.
   */
  .page-head__motto {
    display: flex;
    align-items: center;
    gap: 1ch;
    margin-top: var(--step);
    font-size: var(--text-lead);
    line-height: var(--lh-lead);
    letter-spacing: var(--ls-heading);
    color: var(--text-muted);
  }

  .page-head__motto::before {
    content: '';
    width: clamp(1.5rem, 3vw, 2.75rem);
    height: 1px;
    flex: none;
    background: var(--rule-strong);
  }

  .page-head__body {
    margin-top: var(--step);
    max-width: 52ch;
  }

  .page-head__ctas {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-xs);
    margin-top: var(--step);
  }

  /* --------------------------------------------------------------------- */
  /* Las dos cifras de portada                                             */
  /* --------------------------------------------------------------------- */

  .figures {
    display: grid;
    /* El hilo de 1px entre celdas es el `gap` sobre el borde. */
    gap: 1px;
    margin: 0;
    padding: 0;
    background: var(--rule);
    border: 1px solid var(--rule);
  }

  @media (min-width: 30rem) {
    .figures {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  .figure {
    display: grid;
    align-content: start;
    gap: var(--space-3xs);
    padding: var(--space-xs);
    background: var(--surface);
  }

  .figure__n {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.7ch;
    font-size: var(--text-h3);
    line-height: 1.05;
    letter-spacing: var(--ls-heading);
    font-variant-numeric: tabular-nums;
    color: var(--text);
  }

  .figure__prefix {
    color: var(--text-muted);
  }

  .figure__label {
    color: var(--text-muted);
    max-width: 30ch;
  }

  /* La fuente, a la vista y no en una nota al pie. */
  .figure__source {
    margin-top: var(--space-3xs);
    padding-top: var(--space-3xs);
    border-top: 1px solid var(--rule);
    color: var(--text-muted);
  }

  .lede {
    max-width: 20ch;
  }

  .lede__body {
    margin-top: var(--space-m);
  }

  .pillars {
    display: grid;
    gap: var(--space-l) var(--gutter);
    margin: var(--space-xl) 0 0;
    padding: var(--space-l) 0 0;
    border-top: 1px solid var(--rule);
  }

  @media (min-width: 48rem) {
    .pillars {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  .pillar__n {
    font-variant-numeric: tabular-nums;
  }
  .pillar__icon {
    margin-top: var(--space-m);
  }
  .pillar__title {
    margin-top: var(--space-s);
  }
  .pillar__body {
    margin-top: var(--space-2xs);
    max-width: 32ch;
    color: var(--text-muted);
  }

  .group-title {
    margin-top: var(--space-xl);
    padding-bottom: var(--space-xs);
    border-bottom: 1px solid var(--rule);
  }

  .people {
    display: grid;
    gap: var(--space-l) var(--gutter);
    margin: var(--space-xl) 0 0;
    padding: var(--space-l) 0 0;
    border-top: 1px solid var(--rule);
  }

  .group-title + .people {
    margin-top: var(--space-l);
    padding-top: 0;
    border-top: 0;
  }

  @media (min-width: 48rem) {
    .people {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  .person__role {
    margin-top: var(--space-3xs);
  }

  .person__link {
    margin-top: var(--space-2xs);
  }

  .closing__inner {
    display: grid;
    justify-items: center;
    text-align: center;
    gap: var(--space-l);
  }

  .closing__title {
    max-width: 24ch;
  }
</style>
