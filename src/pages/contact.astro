---
import Base from '../layouts/Base.astro';
import Arrow from '../components/Arrow.astro';
import { site } from '../data/site';
import { legal, condiciones, enLinea, operacionEnLinea } from '../data/legal';

const title = 'Trabaja con nosotros';
const description =
  'Cuéntenos qué proceso quiere automatizar. Respondemos dentro de los dos días hábiles siguientes.';

/*
 * Un solo canal: el correo de la empresa.
 *
 * Por decisión del director (9 de octubre de 2026), la web no recoge datos
 * personales: no hay formulario, ni siquiera uno que se active con una
 * variable de entorno. Quien quiera escribir lo hace desde su propio correo,
 * cuando quiere y con lo que quiere contar. El teléfono tampoco va aquí: sale
 * en las páginas legales, donde la ley lo pide.
 *
 * El formulario (campos, consentimiento de la Ley 1581, honeypot y
 * validación) está en el historial de git antes de este cambio, y su módulo
 * de validación sigue en src/lib/contact.ts para cuando vuelva.
 */
---

<Base title={title} description={description}>
  <section class="section page-head" data-surface="dark">
    <div class="container">
      <p class="t-eyebrow">{title}</p>
      <h1 class="t-h1 page-head__title" data-text-reveal>Cuéntenos qué proceso quiere automatizar.</h1>
      <p class="t-lead page-head__sub">Respondemos dentro de los dos días hábiles siguientes.</p>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="direct">
        <p class="t-h3 direct__lead">Escríbanos.</p>
        <p class="prose direct__body">
          Cuéntenos qué proceso quiere automatizar, quién lo hace hoy y qué le
          gustaría que cambiara. El correo lo leemos nosotros.
        </p>
        <p class="direct__channels">
          <a class="link-arrow" href={`mailto:${site.email}`}>
            {site.email}
            <Arrow />
          </a>
        </p>
      </div>

      {/*
        Lo que un comprador —y Stripe— busca antes de escribir: que no hay
        precios de lista, en qué moneda se cobra, dónde están las condiciones
        y quién es la empresa. No es un canal de contacto ni recoge nada.
      */}
      <div class="terms">
        <h2 class="t-eyebrow terms__title">Cómo cotizamos</h2>
        <p class="prose terms__body">
          No tenemos precios de lista. Cada proyecto se cotiza a la medida y por
          escrito, después de entender el proceso: la cotización fija el alcance, los
          entregables, el calendario y la forma de pago.
          Cotizamos y cobramos en {condiciones.monedas}.
        </p>
        <p class="prose terms__body">
          Las condiciones de pago, cancelación y reembolso están en <a href="/pagos">Pagos, cancelaciones y reembolsos</a>.
        </p>

        <dl class="t-small who">
          <div>
            <dt>Empresa</dt>
            <dd>{legal.nombreComercial} es un nombre comercial de {legal.entidad}.</dd>
          </div>
          <div>
            <dt>Domicilio legal</dt>
            <dd>{enLinea(legal.direccionLegal)}</dd>
          </div>
          <div>
            <dt>Operación</dt>
            <dd>{operacionEnLinea()}</dd>
          </div>
        </dl>
      </div>
    </div>
  </section>
</Base>

<style>
  .page-head {
    padding-top: calc(var(--header-h) + var(--space-2xl));
  }

  .page-head__title {
    margin-top: var(--space-s);
    max-width: 20ch;
  }

  .page-head__sub {
    margin-top: var(--space-m);
    max-width: var(--measure);
  }

  .direct {
    max-width: var(--measure);
  }

  .direct__body {
    margin-top: var(--space-s);
  }

  .direct__channels {
    margin-top: var(--space-m);
  }

  /* Condiciones y empresa: después del canal, separadas por un filete. */
  .terms {
    max-width: var(--measure);
    margin-top: var(--space-xl);
    padding-top: var(--space-s);
    border-top: 1px solid var(--rule);
  }

  .terms__body {
    margin-top: var(--space-xs);
  }

  .terms__body a {
    color: var(--text);
  }

  .who {
    display: grid;
    gap: var(--space-2xs);
    margin-top: var(--space-m);
    color: var(--text-muted);
  }

  .who dt {
    color: var(--text);
  }
</style>
