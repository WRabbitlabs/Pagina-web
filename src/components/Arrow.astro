---
interface Props {
  /** Dirección del trazo. */
  dir?: 'right' | 'left' | 'up' | 'down';
  size?: number;
}
const { dir = 'right', size = 16 } = Astro.props;

const rotation = { right: 0, down: 90, left: 180, up: 270 }[dir];
---

<svg
  width={size}
  height={size}
  viewBox="0 0 16 16"
  fill="none"
  aria-hidden="true"
  focusable="false"
  style={`transform: rotate(${rotation}deg)`}
>
  <path
    d="M2.5 8h11M9 3.5 13.5 8 9 12.5"
    stroke="currentColor"
    stroke-width="1.4"
    stroke-linecap="square"
    stroke-linejoin="miter"></path>
</svg>
