---
/**
 * Set de iconos de pilar.
 *
 * Un solo grid de 24×24, trazo 1.4, currentColor, sin relleno, remates
 * cuadrados. Geometría exclusivamente ortogonal — el mismo idioma que
 * El Trazado, para que se lean como un set y no como tres iconos sueltos.
 */
interface Props {
  name: 'integracion' | 'automatizacion' | 'trazabilidad';
  size?: number;
}
const { name, size = 28 } = Astro.props;
---

<svg
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.4"
  stroke-linecap="square"
  stroke-linejoin="miter"
  aria-hidden="true"
  focusable="false"
>
  {
    /* Integración — dos sistemas distintos, unidos por un codo ortogonal. */
    name === 'integracion' && (
      <>
        <rect x="1.7" y="2.7" width="8" height="8" />
        <rect x="14.3" y="13.3" width="8" height="8" />
        <path d="M9.7 6.7H18.3V13.3" />
      </>
    )
  }
  {
    /* Automatización — un riel que ejecuta pasos declarados, de izq. a der. */
    name === 'automatizacion' && (
      <>
        <path d="M1.7 12H18.6" />
        <path d="M6.5 8.4V15.6" />
        <path d="M11.3 8.4V15.6" />
        <path d="M18.6 8.4V15.6" />
        <path d="M18.6 12H22.3" />
      </>
    )
  }
  {
    /* Trazabilidad — un registro: tres asientos dentro de un corchete. */
    name === 'trazabilidad' && (
      <>
        <path d="M4.7 2.7H1.7V21.3H4.7" />
        <path d="M8.3 6.7H22.3" />
        <path d="M8.3 12H22.3" />
        <path d="M8.3 17.3H22.3" />
      </>
    )
  }
</svg>
