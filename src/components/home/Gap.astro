---
import { gap } from '../../data/home';

/**
 * LA BRECHA — el recibo del proceso manual.
 *
 * Antes esto era un diagrama de tres trayectorias con un área rayada, y se
 * quitó por una razón concreta: necesitaba una nota debajo aclarando que no
 * eran datos medidos. Una forma de gráfica promete medición; si hay que
 * defenderla por escrito, es el aparato equivocado. Encima, dos de las tres
 * curvas vivían al 40% de opacidad y solo se leía una.
 *
 * Un recibo no promete medición: promete partidas. El titular dice que el
 * proceso se paga dos veces, así que la sección enseña las dos facturas del
 * mismo proceso —horas y reconstrucción— con sus renglones, y remata con el
 * total. Es el lenguaje del anexo de un contrato, que es de donde viene el
 * resto del sitio, y no se parece a ninguna otra sección de la página.
 *
 * Sin SVG y sin JS: filetes de 1px, tipografía y espacio. El único relleno de
 * acento es el punto de 6px de la etiqueta.
 */
---

<section class="section gap" aria-labelledby="gap-title">
  <div class="container gap__head">
    <div class="gap__intro">
      <h2 class="t-eyebrow gap__tag" id="gap-title">
        <span class="gap__dot" aria-hidden="true"></span>
        {gap.eyebrow}
      </h2>

      <p class="t-h2 gap__heading" data-text-reveal>{gap.heading}</p>
    </div>

    <div class="gap__aside" data-reveal>
      <p class="gap__body">{gap.body}</p>
      <p class="t-small gap__note">
        <a
          class="gap__source external"
          href={gap.source.href}
          target="_blank"
          rel="noopener noreferrer"
        >
          {gap.source.text}
          <span class="sr-only"> (se abre en una pestaña nueva)</span>
        </a>
      </p>
    </div>
  </div>

  <div class="container">
    <div class="bill">
      {
        gap.payments.map((p, i) => (
          <section class="bill__col" data-reveal style={`--reveal-delay:${i * 90}ms`}>
            <h3 class="bill__head">
              <span class="t-eyebrow bill__label">
                <span class="bill__n">{p.n}</span>
                {p.label}
              </span>
              <span class="t-h3 bill__name">{p.name}</span>
            </h3>

            <ul class="bill__items" role="list">
              {p.items.map((item) => (
                <li class="bill__item">{item}</li>
              ))}
            </ul>
          </section>
        ))
      }
    </div>

    {/* El renglón de abajo: la tercera idea, que como tarjeta suelta competía
        con las otras dos y como total las remata. */}
    <p class="bill__total" data-reveal>
      <span class="t-eyebrow bill__totallabel">{gap.total.label}</span>
      <span class="bill__totaltext">{gap.total.text}</span>
    </p>
  </div>
</section>

<style>
  /*
   * Regla del sitio: una sección, una pantalla. El aire vertical va en `svh`
   * porque lo que desborda es el alto, no el ancho: la escala de espaciado
   * crece con `vw` y en un portátil de 1366×768 sobra ancho y falta alto.
   */
  .gap {
    --pad-v: clamp(5rem, 8svh, 7.5rem);
    --step: clamp(var(--space-2xs), 2.2svh, var(--space-s));

    padding-block: var(--pad-v);
    content-visibility: auto;
    contain-intrinsic-size: auto 76rem;
  }

  @media (max-width: 47.9375rem) {
    .gap {
      --pad-v: clamp(5rem, 8svh, 6rem);
      --step: clamp(var(--space-2xs), 1.8svh, var(--space-s));
    }
  }

  /* --------------------------------------------------------------------- */
  /* Encabezado                                                             */
  /* --------------------------------------------------------------------- */

  .gap__head {
    display: grid;
    gap: var(--step) var(--gutter);
    align-items: end;
    padding-bottom: var(--step);
    margin-bottom: var(--step);
    border-bottom: 1px solid var(--rule);
  }

  @media (min-width: 64rem) {
    .gap__head {
      grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr);
      gap: var(--space-xl);
    }
  }

  .gap__tag {
    display: inline-flex;
    align-items: center;
    gap: 0.7ch;
    padding: 0.4rem 0.7rem;
    background: var(--surface-raised);
    border: 1px solid var(--rule);
    border-radius: var(--radius-btn);
  }

  /* 6px de diámetro, redondo: la ración de lima para un punto de etiqueta. */
  .gap__dot {
    width: 6px;
    height: 6px;
    flex: none;
    border-radius: var(--radius-pill);
    background: var(--signal);
  }

  .gap__heading {
    font-size: min(var(--text-h2), 7.4svh);
    margin-top: var(--step);
    max-width: 16ch;
  }

  .gap__body {
    max-width: 48ch;
    letter-spacing: var(--ls-text);
    color: var(--text-muted);
    font-size: var(--text-body);
    line-height: var(--lh-body);
  }

  .gap__note {
    margin-top: var(--space-2xs);
    letter-spacing: var(--ls-text);
    color: var(--text-muted);
  }

  .gap__source {
    text-decoration: underline;
    text-underline-offset: 0.18em;
    text-decoration-thickness: 1px;
    text-decoration-color: var(--rule);
    transition: text-decoration-color var(--dur-fast) var(--ease-out);
  }

  .gap__source:hover {
    text-decoration-color: currentColor;
  }

  /* --------------------------------------------------------------------- */
  /* El recibo                                                              */
  /* --------------------------------------------------------------------- */

  .bill {
    display: grid;
    gap: var(--space-m);
  }

  @media (min-width: 56rem) {
    .bill {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 0;
    }

    /*
     * El filete que parte el recibo en dos facturas. Va en la segunda columna
     * y no como `gap` con fondo: así llega hasta abajo aunque las dos columnas
     * midan distinto, que es lo que hace que se lea como una sola hoja partida
     * y no como dos bloques puestos al lado.
     */
    .bill__col + .bill__col {
      padding-left: var(--space-l);
      border-left: 1px solid var(--rule);
    }

    .bill__col:first-child {
      padding-right: var(--space-l);
    }
  }

  .bill__head {
    display: grid;
    gap: var(--space-3xs);
    padding-bottom: var(--space-2xs);
  }

  .bill__label {
    display: inline-flex;
    align-items: baseline;
    gap: 0.9ch;
    color: var(--text-muted);
  }

  .bill__n {
    font-variant-numeric: tabular-nums;
  }

  .bill__name {
    /* Escalón de 36–42px de la escala de tracking. */
    letter-spacing: var(--ls-h3);
    color: var(--text);
  }

  .bill__items {
    margin: 0;
    padding: 0;
  }

  /*
   * Cada partida entre filetes, como los renglones de una factura. El de
   * arriba lo pone cada renglón, así que el primero cierra contra el
   * encabezado de su columna sin una regla extra.
   */
  .bill__item {
    /* Paso propio, más corto que --step: son seis renglones y cada píxel
       de acolchado se multiplica por doce en el alto de la sección. */
    padding-block: clamp(var(--space-3xs), 1.7svh, var(--space-xs));
    border-top: 1px solid var(--rule);
    max-width: 44ch;
    letter-spacing: var(--ls-text);
    color: var(--text-muted);
    font-size: var(--text-body);
    line-height: var(--lh-body);
  }

  /* --------------------------------------------------------------------- */
  /* El total                                                               */
  /* --------------------------------------------------------------------- */

  .bill__total {
    display: grid;
    gap: var(--space-3xs) var(--space-m);
    margin-top: var(--step);
    padding-top: var(--step);
    border-top: 1px solid var(--rule);
  }

  @media (min-width: 56rem) {
    .bill__total {
      grid-template-columns: auto minmax(0, 1fr);
      align-items: baseline;
    }
  }

  .bill__totallabel {
    color: var(--text-muted);
  }

  /* El total se lee al peso del titular pequeño: es la conclusión, no una
     nota al pie. */
  .bill__totaltext {
    max-width: 52ch;
    font-size: var(--text-lead);
    line-height: var(--lh-lead);
    letter-spacing: var(--ls-h3);
    color: var(--text);
  }
</style>
