---
import { results, sectors } from '../../data/home';
import { numWidth } from '../../lib/format';

/**
 * EVIDENCIA — cinco cifras sobre un mismo eje.
 *
 * Empezó como cinco tarjetas sueltas: dos con barra, tres con anillo. Se veía
 * mal por una razón que no era de estilo — un anillo al 60% y una barra de 20
 * a 40 no se pueden comparar, y comparar es justo lo que pide una sección
 * titulada «resultados medibles». Aquí las cinco caen sobre una sola escala de
 * 0 a 100 y se leen de un vistazo, en el orden en que están.
 *
 * Dos dibujos, porque son dos clases de dato:
 *
 *   intervalo — la barra flota entre sus extremos, con un trazo fino desde
 *               cero que dice dónde empieza. «20–40%» es un rango, no un 40%.
 *   magnitud  — la barra va de cero al valor.
 *
 * Cada fila lleva su fuente escrita debajo, no detrás de un despliegue: el
 * titular dice «con la fuente a la vista» y eso hay que cumplirlo.
 *
 * ⚠ Las bases de src/data/home.ts son PLACEHOLDER. Ver el aviso de ese
 * archivo.
 */
---

<section class="section results" data-surface="frost" aria-labelledby="results-title">
  <div class="container">
    <div class="results__head">
      <div class="results__intro">
        <h2 class="t-eyebrow results__tag" id="results-title">
          <span class="results__dot" aria-hidden="true"></span>
          {results.eyebrow}
        </h2>

        <p class="t-h2 results__heading" data-text-reveal>
          {results.heading} <span class="results__soft">{results.headingTail}</span>
        </p>
      </div>

      <div class="results__aside" data-reveal>
        <p class="results__body">{results.body}</p>

        <div class="filters" role="group" aria-label="Filtrar por sector">
          {
            results.filters.map((f) => (
              <button
                class="filters__btn t-eyebrow"
                type="button"
                data-sector-filter={f.id}
                aria-pressed={f.id === 'all' ? 'true' : 'false'}
              >
                {f.label}
              </button>
            ))
          }
        </div>
      </div>
    </div>

    <div class="exhibit" data-metrics data-filter="all">
      {/*
        Cabecera del eje: solo las marcas de la escala. La nota de fuente vivía
        aquí, en monoespaciada, y era una frase entera — la mono está reservada
        a navegación, contadores, etiquetas y texto de botón, nunca a texto más
        largo que un rótulo. Se fue al pie de la ficha, que es donde va una nota
        al pie, y en la tipografía de texto.
      */}
      <div class="axis" data-reveal aria-hidden="true">
        <div class="axis__scale">
          {
            results.axis.ticks.map((t) => (
              <span class="axis__tick" style={`--p:${t}%`}>
                {t}
                {t === 100 ? '%' : ''}
              </span>
            ))
          }
        </div>
      </div>

      <ol class="rows" role="list">
        {
          results.metrics.map((m, i) => (
            <li
              class="row"
              data-sector={m.sector}
              data-shape={m.shape}
              data-reveal
              style={`--reveal-delay:${i * 70}ms`}
            >
              <p class="row__fig">
                {'prefix' in m && m.prefix && <span class="t-eyebrow row__prefix">{m.prefix}</span>}
                <span class="row__n">
                  {m.shape === 'range' && (
                    <>
                      <span class="num" data-count={m.from} style={`--w:${numWidth(m.from)}ch`}>
                        {m.from}
                      </span>
                      <span class="row__dash">–</span>
                    </>
                  )}
                  <span class="num" data-count={m.to} style={`--w:${numWidth(m.to)}ch`}>
                    {m.to}
                  </span>
                  <span class="row__unit">{m.unit}</span>
                </span>
              </p>

              <div class="row__text">
                <p class="t-body row__label">{m.label}</p>
                <p class="t-small row__source">
                  <span class="row__sector t-eyebrow">{sectors[m.sector]}</span>
                  {m.source}
                </p>
              </div>

              {/*
                El carril. Decorativo: el intervalo ya está escrito en cifras a
                la izquierda, y repetirlo aquí para un lector de pantalla sería
                decir lo mismo dos veces.
              */}
              <div class="lane" aria-hidden="true">
                <span class="lane__ticks" />
                {m.shape === 'range' && <span class="lane__run" style={`--b:${m.from}%`} />}
                <span class="lane__bar" style={`--a:${m.from}%;--b:${m.to}%`} />
                <span class="lane__cap" style={`--p:${m.to}%`} />
              </div>
            </li>
          ))
        }
      </ol>

      {/*
        Pie de la ficha: la base de todas las cifras y su fuente. En tipografía
        de texto, no monoespaciada; el contador sí es mono, que para eso está.
      */}
      <div class="exhibit__foot">
        <p class="t-small exhibit__note">{results.axis.caption}</p>
        <p class="t-eyebrow exhibit__count" data-filter-count aria-live="polite">
          {results.metrics.length} de {results.metrics.length}
        </p>
      </div>
    </div>
  </div>
</section>

<style>
  /*
   * Regla del sitio: una sección, una pantalla. Con el acolchado de `.section`
   * esta medía 2034px en una ventana de 900. Ver la nota de Gap.astro.
   */
  .results {
    /*
     * Las tres columnas de la ficha se declaran una sola vez, aquí, porque la
     * cabecera del eje y las cinco filas son rejillas independientes y tienen
     * que cuadrar entre sí. La primera columna es de ancho FIJO —no `auto`—:
     * con `auto`, «20–40%» y «70%» darían anchos distintos y cada fila
     * empezaría su carril en un sitio.
     */
    --cols: clamp(5.5rem, 10vw, 8.5rem) minmax(0, 1.25fr) minmax(0, 1fr);

    /* Ver la nota de Gap.astro: el aire vertical va en svh. */
    --pad-v: clamp(5rem, 8svh, 7.5rem);
    --step: clamp(var(--space-2xs), 2.2svh, var(--space-s));

    padding-block: var(--pad-v);
    content-visibility: auto;
    contain-intrinsic-size: auto 89rem;
  }

  /* En móvil el acolchado se recoge: es donde menos alto sobra. */
  @media (max-width: 47.9375rem) {
    .results {
      --pad-v: clamp(5rem, 8svh, 6rem);
      --step: clamp(var(--space-2xs), 1.8svh, var(--space-s));
    }
  }

  /* --------------------------------------------------------------------- */
  /* Encabezado                                                             */
  /* --------------------------------------------------------------------- */

  .results__head {
    display: grid;
    gap: var(--step) var(--gutter);
    padding-bottom: var(--step);
    margin-bottom: var(--step);
    border-bottom: 1px solid var(--rule);
  }

  @media (min-width: 64rem) {
    .results__head {
      grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr);
      align-items: end;
      gap: var(--space-xl);
    }
  }

  .results__tag {
    display: inline-flex;
    align-items: center;
    gap: 0.7ch;
    padding: 0.4rem 0.7rem;
    background: var(--surface-raised);
    border: 1px solid var(--rule);
    border-radius: var(--radius-btn);
  }

  /* 6px de diametro, redondo: la racion de lima para un punto de etiqueta. */
  .results__dot {
    width: 6px;
    height: 6px;
    flex: none;
    border-radius: var(--radius-pill);
    background: var(--signal);
  }

  .results__heading {
    /* Se topa por alto: ver la nota del titular en Gap.astro. */
    font-size: min(var(--text-h2), 7.4svh);
    margin-top: var(--step);
    max-width: 18ch;
  }

  .results__soft {
    color: color-mix(in srgb, var(--ink) 32%, var(--surface));
  }

  .results__body {
    max-width: 46ch;
    color: var(--text-muted);
    font-size: var(--text-body);
    line-height: var(--lh-body);
  }

  /* --------------------------------------------------------------------- */
  /* Filtro                                                                 */
  /* --------------------------------------------------------------------- */

  .filters {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3xs);
    margin-top: var(--step);
  }

  .filters__btn {
    display: inline-flex;
    align-items: center;
    min-height: var(--tap);
    padding-inline: var(--space-xs);
    color: var(--text-muted);
    background: var(--surface-raised);
    border: 1px solid var(--rule);
    border-radius: var(--radius-btn);
    cursor: pointer;
    transition:
      background-color var(--dur-fast) var(--ease-out),
      color var(--dur-fast) var(--ease-out),
      border-color var(--dur-fast) var(--ease-out);
  }

  .filters__btn:hover {
    color: var(--text);
    border-color: var(--rule-strong);
  }

  .filters__btn[aria-pressed='true'] {
    background: var(--ink);
    color: var(--paper);
    border-color: var(--ink);
  }

  /* Sin JS el filtro no filtra: se retira entero y quedan las cinco cifras,
     que es el contenido. Un botón que no hace nada es peor que no tenerlo. */
  html:not(.js) .filters {
    display: none;
  }

  /* --------------------------------------------------------------------- */
  /* Cabecera del eje                                                       */
  /* --------------------------------------------------------------------- */

  .axis {
    display: grid;
    gap: var(--gutter);
    align-items: end;
  }

  .axis__scale {
    position: relative;
    height: 1rem;
    display: none;
  }

  .axis__tick {
    position: absolute;
    left: var(--p);
    bottom: 0;
    transform: translateX(-50%);
    font-family: var(--font-mono);
    font-size: var(--text-nav);
    letter-spacing: var(--ls-mono);
    color: var(--text-muted);
    font-variant-numeric: tabular-nums;
  }

  /* El primero y el último se pegan a su borde: centrados se salen del carril. */
  .axis__tick:first-child {
    transform: none;
  }

  .axis__tick:last-child {
    transform: translateX(-100%);
  }

  @media (min-width: 64rem) {
    .axis {
      grid-template-columns: var(--cols);
    }

    /* La escala va sobre la tercera columna, que es la del carril. */
    .axis__scale {
      grid-column: 3;
      display: block;
    }
  }

  /* --------------------------------------------------------------------- */
  /* Las cinco filas                                                        */
  /* --------------------------------------------------------------------- */

  .rows {
    margin: 0;
    padding: 0;
    border-top: 1px solid var(--rule);
  }

  .row {
    display: grid;
    gap: var(--space-2xs) var(--gutter);
    align-items: center;
    padding-block: var(--space-2xs);
    border-bottom: 1px solid var(--rule);
    transition: background-color var(--dur-fast) var(--ease-out);
  }

  @media (min-width: 64rem) {
    .row {
      grid-template-columns: var(--cols);
      /* Cinco filas: cada píxel de acolchado cuesta diez. Atado al alto de la
         ventana, en un portátil bajo se recogen sin tocar el texto. */
      padding-block: clamp(var(--space-3xs), 1.5svh, var(--space-2xs));
    }
  }

  /* La fila entera reacciona al puntero: es lo que hace legible una tabla
     larga sin pintarle bandas de color. */
  @media (hover: hover) {
    .row:hover {
      background: color-mix(in srgb, var(--ink) 4%, transparent);
    }
  }

  .metrics-hidden,
  .exhibit:not([data-filter='all']) .row:not(.is-match) {
    display: none;
  }

  /* --------------------------------------------------------------------- */
  /* La cifra                                                              */
  /* --------------------------------------------------------------------- */

  .row__prefix {
    display: block;
    color: var(--text-muted);
  }

  .row__n {
    display: block;
    font-size: var(--text-h3);
    line-height: 1.05;
    /* Escalon de 36-42px de la escala de tracking. */
    letter-spacing: var(--ls-h3);
    font-variant-numeric: tabular-nums;
    color: var(--text);
    white-space: nowrap;
  }

  /* Ancho reservado en `ch`: el contador no empuja al guion ni al símbolo. */
  .num {
    display: inline-block;
    min-width: var(--w);
  }

  .row__dash,
  .row__unit {
    color: var(--text-muted);
  }

  /* --------------------------------------------------------------------- */
  /* Texto y fuente                                                         */
  /* --------------------------------------------------------------------- */

  .row__label {
    /* Escalon de 16-19px de la escala de tracking. */
    letter-spacing: var(--ls-text);
    color: var(--text);
    text-wrap: balance;
  }

  .row__source {
    margin-top: var(--space-3xs);
    letter-spacing: var(--ls-text);
    color: var(--text-muted);
  }

  .row__sector {
    display: inline-block;
    margin-right: 0.6ch;
    padding: 0.2rem 0.5rem;
    /* Filete de 1px, no relleno: la profundidad sale del borde, nunca de una
       superficie tintada ni de una sombra. */
    border: 1px solid var(--rule);
    border-radius: var(--radius-btn);
    color: var(--text-muted);
    /* Alinea la pastilla con la línea de texto que la sigue. */
    vertical-align: 0.05em;
  }

  /* --------------------------------------------------------------------- */
  /* El carril                                                              */
  /* --------------------------------------------------------------------- */

  .lane {
    position: relative;
    height: clamp(var(--space-xs), 3svh, var(--space-s));
  }

  /* Marcas cada 25%. Son lo que convierte el carril en una escala. */
  .lane__ticks {
    position: absolute;
    inset: 25% 0;
    border-right: 1px solid var(--rule);
    background-image: repeating-linear-gradient(
      to right,
      var(--rule) 0 1px,
      transparent 1px 25%
    );
  }

  /* Sólo en intervalos: de cero al primer extremo, fino, para situar el rango
     en la escala sin que parezca que la cifra empieza en cero. */
  .lane__run {
    position: absolute;
    top: calc(50% - 1px);
    left: 0;
    width: var(--b);
    /* Sobre lienzo claro la hairline es --rule; --rule-strong es la de
       superficie oscura y aqui pesaba de mas. */
    height: 1px;
    background: var(--rule);
  }

  .lane__bar {
    position: absolute;
    top: calc(50% - 4px);
    left: var(--a);
    width: calc(var(--b) - var(--a));
    height: 8px;
    background: var(--ink);
    transform: scaleX(0);
    transform-origin: left center;
    transition: transform 800ms var(--ease-out) 200ms;
  }

  .row.is-revealed .lane__bar {
    transform: scaleX(1);
  }

  /* El unico relleno de acento de la seccion: cinco puntos de 6px al final
     de cada barra, que es donde esta el dato. Redondos y a 6px, que es la
     racion de lima para un punto. */
  .lane__cap {
    position: absolute;
    top: calc(50% - 3px);
    left: var(--p);
    width: 6px;
    height: 6px;
    margin-left: -6px;
    border-radius: var(--radius-pill);
    background: var(--signal);
    opacity: 0;
    transition: opacity var(--dur-mid) var(--ease-out) 900ms;
  }

  .row.is-revealed .lane__cap {
    opacity: 1;
  }

  html:not(.js) .lane__bar {
    transform: scaleX(1);
  }

  html:not(.js) .lane__cap {
    opacity: 1;
  }

  /* En móvil el carril va debajo del texto, a lo ancho de la tarjeta. */
  @media (max-width: 63.9375rem) {
    .lane {
      height: 1.75rem;
      grid-column: 1 / -1;
    }
  }

  .exhibit__foot {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-2xs) var(--gutter);
    margin-top: var(--space-2xs);
  }

  .exhibit__note {
    max-width: 62ch;
    letter-spacing: var(--ls-text);
    color: var(--text-muted);
  }

  .exhibit__count {
    color: var(--text-muted);
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }

  @media (prefers-reduced-motion: reduce) {
    .lane__bar {
      transform: scaleX(1);
      transition: none;
    }

    .lane__cap {
      opacity: 1;
      transition: none;
    }

    .row,
    .filters__btn {
      transition: none;
    }
  }
</style>

<script>
  import { counters } from '../../scripts/count';

  counters();

  /*
   * Filtro por sector.
   *
   * Quién se ve lo decide el CSS: aquí solo se escribe `data-filter` en la
   * ficha y se marca `is-match` en las filas del sector elegido. La razón de
   * marcar en vez de ocultar es que hace falta saber CUÁLES vuelven a
   * aparecer para repetirles la animación de entrada — si no, al filtrar
   * saldrían de golpe, con las barras ya dibujadas.
   */
  const list = document.querySelector<HTMLElement>('[data-metrics]');
  const buttons = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-sector-filter]'));
  const count = document.querySelector<HTMLElement>('[data-filter-count]');

  if (list && buttons.length) {
    const rows = Array.from(list.querySelectorAll<HTMLElement>('.row'));
    const total = rows.length;

    const apply = (sector: string) => {
      list.dataset.filter = sector;

      const shown = rows.filter((r) => sector === 'all' || r.dataset.sector === sector);
      rows.forEach((r) => r.classList.toggle('is-match', shown.includes(r)));

      if (count) count.textContent = `${shown.length} de ${total}`;

      /* El reflujo forzado entre quitar y poner la clase es lo que reinicia
         la transición: sin él, el navegador agrupa los dos cambios. */
      shown.forEach((r) => {
        r.classList.remove('is-revealed');
        void r.offsetWidth;
        r.classList.add('is-revealed');
      });
    };

    buttons.forEach((btn) => {
      btn.addEventListener('click', () => {
        const sector = btn.dataset.sectorFilter!;
        if (list.dataset.filter === sector) return;

        buttons.forEach((b) => b.setAttribute('aria-pressed', String(b === btn)));
        apply(sector);
      });
    });
  }
</script>
