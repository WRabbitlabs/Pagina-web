---
import { results, sectors } from '../../data/home';
import { numWidth } from '../../lib/format';

/**
 * EVIDENCIA — cinco cifras leídas con un calibre.
 *
 * Tercera versión, y las dos anteriores explican esta. Primero fueron cinco
 * tarjetas sueltas, tres con anillo y dos con barra: un anillo al 60% y una
 * barra de 20 a 40 no se pueden comparar, que es justo lo que pide una
 * sección titulada «resultados medibles». Después fue una tabla con barras
 * sobre un eje común: comparaba bien, pero una barra de progreso no mide
 * nada, solo se llena.
 *
 * Un calibre sí mide. Cada fila lleva su regla graduada —marca menor cada 5%,
 * mayor cada 25%— y el valor es una horquilla con topes, no un relleno. La
 * cifra vive sobre sus propios topes y no en otra columna, que es lo que la
 * convierte en la lectura de un instrumento en vez de en una etiqueta al lado
 * de un adorno.
 *
 * La diferencia entre un rango y una magnitud queda dibujada sin explicarla:
 * «20–40%» abre la horquilla entre sus dos extremos; «70%», desde cero.
 *
 * Al pasar el puntero se enciende la graduación que cae bajo la medida: el
 * tramo medido se lee más oscuro que el resto de la regla.
 *
 * ⚠ Las bases de src/data/home.ts son PLACEHOLDER. Ver el aviso de ese
 * archivo.
 */

/* ---------------------------------------------------------------------- */
/* Geometría del calibre. Coordenadas del viewBox, como en Trazado.astro.  */
/* ---------------------------------------------------------------------- */

/** 1000 unidades = 100%, así que un punto de escala son 10 del viewBox. */
const W = 1000;
const H = 34;
const U = W / 100;

/** El eje arriba; la graduación cuelga de él. */
const AX = 1;
const MINOR = 8;
const MAJOR = 14;

/** Marca menor cada 5%. Las de 25 en 25 las dibuja la mayor. */
const minorD = Array.from({ length: 21 }, (_, i) => i * 5)
  .filter((p) => p % 25 !== 0)
  .map((p) => `M${p * U} ${AX} V${MINOR}`)
  .join(' ');

const majorD = [0, 25, 50, 75, 100].map((p) => `M${p * U} ${AX} V${MAJOR}`).join(' ');

/**
 * La horquilla: tope, travesaño, tope. Un solo trazo, para que se dibuje de
 * una pasada con `pathLength` y sin medir nada en el cliente.
 */
const bracket = (a: number, b: number) =>
  `M${a * U} 21 V33 M${a * U} 27 H${b * U} M${b * U} 21 V33`;

const metrics = results.metrics.map((m) => ({
  ...m,
  isRange: m.shape === 'range',
  d: bracket(m.from, m.to),
  /** Tramo de regla bajo la medida. Se enciende al pasar el puntero. */
  lit: { x: m.from * U, w: (m.to - m.from) * U },
}));
---

<section class="section results" data-surface="frost" aria-labelledby="results-title">
  <div class="container">
    <div class="results__head">
      <div class="results__intro">
        <h2 class="t-eyebrow results__tag" id="results-title">
          <span class="results__dot" aria-hidden="true"></span>
          {results.eyebrow}
        </h2>

        <p class="t-h2 results__heading" data-text-reveal>
          {results.heading} <span class="results__soft">{results.headingTail}</span>
        </p>
      </div>

      <div class="results__aside" data-reveal>
        <p class="results__body">{results.body}</p>

        <div class="filters" role="group" aria-label="Filtrar por sector">
          {
            results.filters.map((f) => (
              <button
                class="filters__btn t-eyebrow"
                type="button"
                data-sector-filter={f.id}
                aria-pressed={f.id === 'all' ? 'true' : 'false'}
              >
                {f.label}
              </button>
            ))
          }
        </div>
      </div>
    </div>

    <div class="exhibit" data-metrics data-filter="all">
      {/*
        Rótulos de la escala. Se escriben una vez y mandan sobre las cinco
        reglas de abajo, que llevan la graduación pero no los números.
      */}
      <div class="axis" data-reveal aria-hidden="true">
        <div class="axis__scale">
          {
            results.axis.ticks.map((t) => (
              <span class="axis__tick" style={`--p:${t}%`}>
                {t}
                {t === 100 ? '%' : ''}
              </span>
            ))
          }
        </div>
      </div>

      <ol class="rows" role="list">
        {
          metrics.map((m, i) => (
            <li
              class="row"
              data-sector={m.sector}
              data-shape={m.shape}
              data-reveal
              style={`--reveal-delay:${i * 70}ms`}
            >
              <div class="row__text">
                <p class="t-body row__label">{m.label}</p>
                <p class="t-small row__source">
                  <span class="row__sector t-eyebrow">{sectors[m.sector]}</span>
                  {m.source}
                </p>
              </div>

              {/*
                El calibre. Decorativo para un lector de pantalla: la medida
                está escrita en cifras justo debajo, y repetirla aquí sería
                decir lo mismo dos veces.
              */}
              <div class="cal">
                <svg
                  class="cal__svg"
                  viewBox={`0 0 ${W} ${H}`}
                  preserveAspectRatio="none"
                  aria-hidden="true"
                  fill="none"
                >
                  <defs>
                    <clipPath id={`lit-${m.id}`}>
                      <rect x={m.lit.x} y="0" width={m.lit.w} height={H} />
                    </clipPath>
                  </defs>

                  <path class="cal__axis" d={`M0 ${AX} H${W}`} />
                  <path class="cal__tick" d={minorD} />
                  <path class="cal__tick cal__tick--major" d={majorD} />

                  {/* La misma graduación, recortada al tramo medido. */}
                  <g class="cal__lit" clip-path={`url(#lit-${m.id})`}>
                    <path class="cal__tick" d={minorD} />
                    <path class="cal__tick cal__tick--major" d={majorD} />
                  </g>

                  <path class="cal__bracket" d={m.d} pathLength="1" />
                </svg>

                {/* La lectura, sobre sus topes. */}
                <p class="cal__read">
                  {m.isRange && (
                    <span class="cal__val" style={`--p:${m.from}%`}>
                      <span class="num" data-count={m.from} style={`--w:${numWidth(m.from)}ch`}>
                        {m.from}
                      </span>
                    </span>
                  )}

                  <span class="cal__val" style={`--p:${m.to}%`}>
                    {'prefix' in m && m.prefix && <span class="t-eyebrow cal__pre">{m.prefix}</span>}
                    <span class="num" data-count={m.to} style={`--w:${numWidth(m.to)}ch`}>
                      {m.to}
                    </span>
                    <span class="cal__unit">{m.unit}</span>
                  </span>
                </p>
              </div>
            </li>
          ))
        }
      </ol>

      {/*
        Pie de la ficha: la base de todas las cifras y su fuente. En tipografía
        de texto, no monoespaciada; el contador sí es mono, que para eso está.
      */}
      <div class="exhibit__foot">
        <p class="t-small exhibit__note">{results.axis.caption}</p>
        <p class="t-eyebrow exhibit__count" data-filter-count aria-live="polite">
          {results.metrics.length} de {results.metrics.length}
        </p>
      </div>
    </div>
  </div>
</section>

<style>
  .results {
    /*
     * Dos columnas: el concepto y su regla. La cifra ya no tiene columna
     * propia —vive sobre los topes de su horquilla—, que es lo que hace que
     * se lea como una medición y no como una etiqueta al lado de un dibujo.
     */
    --cols: minmax(0, 1fr) minmax(0, 1.15fr);

    /* Separación de 80–120px, en `svh` para que la sección quepa en una
       ventana baja sin bajar del suelo de la regla. */
    --pad-v: clamp(5rem, 8svh, 7.5rem);
    --step: clamp(var(--space-2xs), 2.2svh, var(--space-s));

    padding-block: var(--pad-v);
    content-visibility: auto;
    contain-intrinsic-size: auto 87rem;
  }

  @media (max-width: 47.9375rem) {
    .results {
      --pad-v: clamp(5rem, 8svh, 6rem);
      --step: clamp(var(--space-2xs), 1.8svh, var(--space-s));
    }
  }

  /* --------------------------------------------------------------------- */
  /* Encabezado                                                             */
  /* --------------------------------------------------------------------- */

  .results__head {
    display: grid;
    gap: var(--step) var(--gutter);
    padding-bottom: var(--step);
    margin-bottom: var(--step);
    border-bottom: 1px solid var(--rule);
  }

  @media (min-width: 64rem) {
    .results__head {
      grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr);
      align-items: end;
      gap: var(--space-xl);
    }
  }

  .results__tag {
    display: inline-flex;
    align-items: center;
    gap: 0.7ch;
    padding: 0.4rem 0.7rem;
    background: var(--surface-raised);
    border: 1px solid var(--rule);
    border-radius: var(--radius-btn);
  }

  /* 6px de diámetro, redondo: la ración de lima para un punto de etiqueta. */
  .results__dot {
    width: 6px;
    height: 6px;
    flex: none;
    border-radius: var(--radius-pill);
    background: var(--signal);
  }

  .results__heading {
    font-size: min(var(--text-h2), 7.4svh);
    margin-top: var(--step);
    max-width: 18ch;
  }

  .results__soft {
    color: color-mix(in srgb, var(--ink) 32%, var(--surface));
  }

  .results__body {
    max-width: 46ch;
    letter-spacing: var(--ls-text);
    color: var(--text-muted);
    font-size: var(--text-body);
    line-height: var(--lh-body);
  }

  /* --------------------------------------------------------------------- */
  /* Filtro                                                                 */
  /* --------------------------------------------------------------------- */

  .filters {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3xs);
    margin-top: var(--step);
  }

  .filters__btn {
    display: inline-flex;
    align-items: center;
    min-height: var(--tap);
    padding-inline: var(--space-xs);
    color: var(--text-muted);
    background: var(--surface-raised);
    border: 1px solid var(--rule);
    border-radius: var(--radius-btn);
    cursor: pointer;
    transition:
      background-color var(--dur-fast) var(--ease-out),
      color var(--dur-fast) var(--ease-out),
      border-color var(--dur-fast) var(--ease-out);
  }

  .filters__btn:hover {
    color: var(--text);
    border-color: var(--rule-strong);
  }

  /* Acción sobre superficie opuesta: relleno tinta sobre lienzo claro. */
  .filters__btn[aria-pressed='true'] {
    background: var(--ink);
    color: var(--paper);
    border-color: var(--ink);
  }

  html:not(.js) .filters {
    display: none;
  }

  /* --------------------------------------------------------------------- */
  /* Rótulos de la escala                                                   */
  /* --------------------------------------------------------------------- */

  .axis {
    display: grid;
    gap: var(--gutter);
    align-items: end;
  }

  .axis__scale {
    position: relative;
    height: 1rem;
    display: none;
  }

  .axis__tick {
    position: absolute;
    left: var(--p);
    bottom: 0;
    transform: translateX(-50%);
    font-family: var(--font-mono);
    font-size: var(--text-nav);
    letter-spacing: var(--ls-mono);
    color: var(--text-muted);
    font-variant-numeric: tabular-nums;
  }

  .axis__tick:first-child {
    transform: none;
  }

  .axis__tick:last-child {
    transform: translateX(-100%);
  }

  @media (min-width: 64rem) {
    .axis {
      grid-template-columns: var(--cols);
    }

    .axis__scale {
      grid-column: 2;
      display: block;
    }
  }

  /* --------------------------------------------------------------------- */
  /* Las cinco filas                                                        */
  /* --------------------------------------------------------------------- */

  .rows {
    margin: 0;
    padding: 0;
    border-top: 1px solid var(--rule);
  }

  .row {
    display: grid;
    gap: var(--space-2xs) var(--gutter);
    align-items: center;
    padding-block: clamp(var(--space-3xs), 1.2svh, var(--space-2xs));
    border-bottom: 1px solid var(--rule);
    transition: background-color var(--dur-fast) var(--ease-out);
  }

  @media (min-width: 64rem) {
    .row {
      grid-template-columns: var(--cols);
    }
  }

  .exhibit:not([data-filter='all']) .row:not(.is-match) {
    display: none;
  }

  .row__label {
    letter-spacing: var(--ls-text);
    color: var(--text);
    text-wrap: balance;
  }

  .row__source {
    margin-top: var(--space-3xs);
    letter-spacing: var(--ls-text);
    color: var(--text-muted);
  }

  .row__sector {
    display: inline-block;
    margin-right: 0.6ch;
    padding: 0.2rem 0.5rem;
    /* Filete de 1px, no relleno: la profundidad sale del borde. */
    border: 1px solid var(--rule);
    border-radius: var(--radius-btn);
    color: var(--text-muted);
    vertical-align: 0.05em;
  }

  /* --------------------------------------------------------------------- */
  /* El calibre                                                             */
  /* --------------------------------------------------------------------- */

  .cal {
    position: relative;
  }

  .cal__svg {
    display: block;
    width: 100%;
    /*
     * `preserveAspectRatio="none"` estira el viewBox a lo ancho, así que el
     * alto se fija aquí y los trazos se compensan con `vector-effect`: sin él,
     * una regla estirada 3× tendría marcas de tres píxeles.
     */
    height: clamp(1.25rem, 2.6svh, 1.75rem);
    overflow: visible;
  }

  .cal__axis,
  .cal__tick,
  .cal__bracket {
    stroke: var(--rule);
    stroke-width: 1;
    vector-effect: non-scaling-stroke;
  }

  /* La marca de 25 en 25 es la que estructura la lectura. */
  .cal__tick--major {
    stroke: var(--rule-strong);
    opacity: 0.5;
  }

  /* El tramo medido, encendido bajo el puntero. */
  .cal__lit {
    opacity: 0;
    transition: opacity var(--dur-fast) var(--ease-out);
  }

  .cal__lit .cal__tick {
    stroke: var(--rule-strong);
  }

  @media (hover: hover) {
    .row:hover {
      background: color-mix(in srgb, var(--ink) 3%, transparent);
    }

    .row:hover .cal__lit {
      opacity: 1;
    }
  }

  /*
   * La horquilla se dibuja de un trazo. `pathLength="1"` normaliza el largo,
   * así que el mismo dasharray sirve para las cinco sin medir nada con JS.
   */
  .cal__bracket {
    stroke: var(--ink);
    stroke-width: 2;
    stroke-linecap: butt;
    stroke-dasharray: 1;
    stroke-dashoffset: 1;
    transition: stroke-dashoffset 900ms var(--ease-out) 180ms;
  }

  .row.is-revealed .cal__bracket {
    stroke-dashoffset: 0;
  }

  html:not(.js) .cal__bracket {
    stroke-dashoffset: 0;
  }

  /* --------------------------------------------------------------------- */
  /* La lectura                                                             */
  /* --------------------------------------------------------------------- */

  .cal__read {
    position: relative;
    /* Alto reservado: la fila no salta cuando la cifra aparece. */
    height: calc(min(var(--text-h3), 3.6svh) * 1.02);
    margin-top: calc(var(--space-3xs) / 2);
  }

  .cal__val {
    position: absolute;
    top: 0;
    left: var(--p);
    transform: translateX(-50%);
    display: flex;
    align-items: baseline;
    gap: 0.3ch;
    font-size: min(var(--text-h3), 3.6svh);
    line-height: 1.02;
    /* Escalón de 36–42px de la escala de tracking. */
    letter-spacing: var(--ls-h3);
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
    color: var(--text);
    opacity: 0;
    transition: opacity var(--dur-mid) var(--ease-out) 760ms;
  }

  .row.is-revealed .cal__val {
    opacity: 1;
  }

  html:not(.js) .cal__val {
    opacity: 1;
  }

  /* La lectura de cero se pega al borde: centrada se saldría de la regla. */
  .cal__val[style*='--p:0%'] {
    transform: none;
  }

  .cal__pre {
    align-self: center;
    color: var(--text-muted);
  }

  .cal__unit {
    color: var(--text-muted);
  }

  /* Ancho reservado en `ch`: el contador no empuja al símbolo. */
  .num {
    display: inline-block;
    min-width: var(--w);
  }

  /* --------------------------------------------------------------------- */
  /* Pie                                                                    */
  /* --------------------------------------------------------------------- */

  .exhibit__foot {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-2xs) var(--gutter);
    margin-top: var(--space-2xs);
  }

  .exhibit__note {
    max-width: 62ch;
    letter-spacing: var(--ls-text);
    color: var(--text-muted);
  }

  .exhibit__count {
    color: var(--text-muted);
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }

  @media (prefers-reduced-motion: reduce) {
    .cal__bracket {
      stroke-dashoffset: 0;
      transition: none;
    }

    .cal__val {
      opacity: 1;
      transition: none;
    }

    .row,
    .cal__lit,
    .filters__btn {
      transition: none;
    }
  }
</style>

<script>
  import { counters } from '../../scripts/count';

  counters();

  /*
   * Filtro por sector. Quién se ve lo decide el CSS: aquí solo se escribe
   * `data-filter` en la ficha y se marca `is-match` en las filas del sector.
   * Se marca en vez de ocultar porque hace falta saber CUÁLES vuelven a
   * aparecer para repetirles el trazado de la horquilla.
   */
  const list = document.querySelector<HTMLElement>('[data-metrics]');
  const buttons = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-sector-filter]'));
  const count = document.querySelector<HTMLElement>('[data-filter-count]');

  if (list && buttons.length) {
    const rows = Array.from(list.querySelectorAll<HTMLElement>('.row'));
    const total = rows.length;

    const apply = (sector: string) => {
      list.dataset.filter = sector;

      const shown = rows.filter((r) => sector === 'all' || r.dataset.sector === sector);
      rows.forEach((r) => r.classList.toggle('is-match', shown.includes(r)));

      if (count) count.textContent = `${shown.length} de ${total}`;

      /* El reflujo forzado entre quitar y poner la clase reinicia la
         transición: sin él, el navegador agrupa los dos cambios. */
      shown.forEach((r) => {
        r.classList.remove('is-revealed');
        void r.offsetWidth;
        r.classList.add('is-revealed');
      });
    };

    buttons.forEach((btn) => {
      btn.addEventListener('click', () => {
        const sector = btn.dataset.sectorFilter!;
        if (list.dataset.filter === sector) return;

        buttons.forEach((b) => b.setAttribute('aria-pressed', String(b === btn)));
        apply(sector);
      });
    });
  }
</script>
