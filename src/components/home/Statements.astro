---
import { whatWeDo } from '../../data/home';

/**
 * Declaraciones que se leen solas con el scroll.
 *
 * Tres enunciados, un tercio del recorrido cada uno. Dentro de su tramo las
 * letras se encienden de izquierda a derecha como si alguien fuera leyendo;
 * al terminar, las líneas salen por arriba y las del siguiente suben desde
 * abajo, escalonadas.
 *
 * Dos decisiones que gobiernan todo lo demás:
 *
 * 1. El encendido es POR CARÁCTER, no por palabra, y el frente es duro: en
 *    todo momento hay un único carácter a medio encender. Por palabra el
 *    frente avanza a saltos de unos 150px a este cuerpo y se ve como un
 *    interruptor; con un degradado ancho no se ve nada, porque entre
 *    caracteres vecinos hay un 2% y el ojo no lo distingue. Ver --ramp.
 *
 * 2. El troceo se hace en el servidor. En el cliente habría reflujo al
 *    hidratar; y sin JS el texto tiene que quedarse entero y encendido.
 *
 * Coste asumido: partir en caracteres rompe el kerning, porque el navegador no
 * ajusta pares entre elementos distintos. A este cuerpo y con el tracking
 * cerrado de la display no se nota, y es el precio de que el frente sea
 * continuo.
 */

const statements = whatWeDo.statements;
const total = statements.length;
const pad = (n: number) => String(n).padStart(2, '0');

/**
 * Numera cada carácter dentro del enunciado, con el índice corrido de una
 * línea a la siguiente: el frente de lectura no se reinicia en cada línea.
 * Los espacios cuentan para el índice pero no se envuelven — así la línea
 * puede partirse sola si la pantalla es muy estrecha.
 */
const layout = statements.map((lines) => {
  let i = 0;
  const rows = lines.map((line) =>
    Array.from(line).map((ch) => ({ ch, i: i++ })),
  );
  return { rows, n: i, flat: lines.join(' ') };
});
---

<section
  class="say"
  data-say
  style={`--total:${total}`}
  aria-labelledby="say-title"
>
  <div class="say__pin">
    <div class="say__top">
      <div class="container say__topline">
        <h2 class="t-eyebrow say__label" id="say-title">
          <span class="say__dot" aria-hidden="true"></span>
          {whatWeDo.eyebrow}
        </h2>

        {/*
          Barra de avance: dice cuánto queda de sección. Es la única señal de
          que el bloque está fijado a propósito y no atascado — sin ella el
          scroll parece no responder mientras duran los tres enunciados.
        */}
        <span class="say__track" aria-hidden="true">
          <span class="say__prog"></span>
        </span>
      </div>
    </div>

    <div class="container say__inner">
      <p class="t-eyebrow say__count" aria-hidden="true">
        <span data-count>{pad(1)}</span>
        <span class="say__slash">/</span>
        {pad(total)}
      </p>

      <div class="say__stack" data-stack>
        {
          layout.map(({ rows, n, flat }, s) => (
            <p
              class="t-statement say__text"
              class:list={[s === 0 && 'is-current']}
              data-statement
              data-index={s}
              style={`--n:${n}`}
              aria-hidden={s === 0 ? undefined : 'true'}
            >
              {/*
                Copia intacta para el lector de pantalla: oír el texto letra a
                letra, con un elemento por carácter, sería insufrible.
              */}
              <span class="sr-only">{flat}</span>

              <span aria-hidden="true">
                {rows.map((chars, l) => (
                  <span class="say__mask" style={`--l:${l}`}>
                    <span class="say__line">
                      {chars.map(({ ch, i }) =>
                        ch === ' ' ? (
                          ' '
                        ) : (
                          <span class="say__c" style={`--i:${i}`}>
                            {ch}
                          </span>
                        ),
                      )}
                    </span>
                  </span>
                ))}
              </span>
            </p>
          ))
        }
      </div>
    </div>
  </div>
</section>

<style>
  .say {
    position: relative;
    z-index: 1;
    /* Un viewport y medio por enunciado: da aire para leerlo ya encendido
       antes de que se vaya. */
    height: calc(150svh * var(--total));
  }

  .say__pin {
    position: sticky;
    top: 0;
    height: 100svh;
    display: grid;
    grid-template-rows: auto 1fr;
    color: var(--paper);
  }

  /* Hairline superior: separa el hero de esta sección sin cambiar el fondo. */
  .say__top {
    padding-top: calc(var(--header-h) + var(--space-m));
  }

  .say__topline {
    position: relative;
    padding-bottom: var(--space-s);
  }

  /* El filete pasa a ser un elemento propio para que la barra pueda montarse
     exactamente encima; como borde no habría dónde apoyarla. */
  .say__track {
    position: absolute;
    inset: auto 0 0 0;
    height: 1px;
    background: color-mix(in srgb, var(--paper) 18%, transparent);
  }

  .say__prog {
    display: block;
    height: 100%;
    background: var(--signal);
    transform: scaleX(var(--prog, 0));
    transform-origin: left center;
  }

  .say__label {
    display: inline-flex;
    align-items: center;
    gap: 0.6ch;
    color: var(--paper);
  }

  .say__dot {
    width: 6px;
    height: 6px;
    background: var(--signal);
    border-radius: 50%;
    flex: none;
  }

  .say__inner {
    display: grid;
    align-content: center;
    gap: var(--space-m);
  }

  /*
   * A partir de escritorio el texto se va a la derecha y el contador se queda
   * solo en el margen izquierdo. La proporción 1:2 deja el bloque empezando a
   * un tercio del ancho, que es donde cae en la referencia.
   */
  @media (min-width: 64rem) {
    .say__inner {
      grid-template-columns: minmax(0, 1fr) minmax(0, 2fr);
      align-items: start;
      align-content: center;
      gap: var(--gutter);
    }
  }

  /* Contador en píldora: borde de 1px, radio completo, cifras tabulares. */
  .say__count {
    display: inline-flex;
    align-items: center;
    gap: 0.6ch;
    align-self: start;
    /* Sin esto la píldora se estira a todo el ancho de la celda de grid. */
    justify-self: start;
    padding: 0.5rem 0.9rem;
    border: 1px solid color-mix(in srgb, var(--paper) 34%, transparent);
    border-radius: var(--radius-pill);
    color: var(--paper);
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }

  .say__slash {
    color: color-mix(in srgb, var(--paper) 45%, transparent);
  }

  /* Los tres comparten celda: el bloque reserva el alto del más largo y el
     cambio no mueve nada de sitio. */
  .say__stack {
    display: grid;
  }

  .say__text {
    grid-area: 1 / 1;
  }

  /* ------------------------------------------------------------------ */
  /* Entrada y salida por línea                                          */
  /* ------------------------------------------------------------------ */

  /*
   * Cada línea vive dentro de una caja recortada. El padding compensado con
   * margen negativo le da sitio a las colas de la g, la j y la q: sin él, el
   * recorte se las come.
   */
  .say__mask {
    display: block;
    overflow: clip;
    padding-bottom: 0.18em;
    margin-bottom: -0.18em;
  }

  /*
   * Tres posiciones, y la que toca sale del índice, no de un temporizador:
   *
   *   índice menor que el vigente  → ya pasó, está arriba
   *   índice vigente               → en su sitio
   *   índice mayor                 → esperando abajo
   *
   * Al subir el scroll, el vigente pasa a ser "mayor" y baja solo. Por eso el
   * gesto es reversible sin ninguna clase de reinicio ni ningún timeout que
   * pueda quedarse colgado.
   */
  .say__line {
    display: block;
    transform: translateY(110%);
    transition: transform var(--dur-slow) var(--ease-out);
    /* Escalonado en orden de lectura: la primera línea sale primero. */
    transition-delay: calc(var(--l) * 55ms);
  }

  .say__text.is-out .say__line {
    transform: translateY(-110%);
  }

  /*
   * El que entra espera 280ms. Sin esa espera, el que sale y el que entra
   * recorren la máscara a la vez y se cruzan a media altura: dos frases
   * distintas superpuestas durante medio segundo. Con ella el hueco queda
   * limpio antes de que llegue la siguiente, y el relevo se lee como un
   * relevo y no como un choque.
   */
  .say__text.is-current .say__line {
    transform: none;
    transition-delay: calc(280ms + var(--l) * 70ms);
  }

  /* ------------------------------------------------------------------ */
  /* El encendido                                                        */
  /* ------------------------------------------------------------------ */

  /*
   * --p (0→1) lo escribe el scroll sobre el enunciado vigente. Un carácter
   * está encendido cuando el frente de lectura ha pasado su índice.
   *
   * --ramp es la anchura del frente en caracteres, y vale 1 a propósito.
   * Medido sobre la referencia, su perfil es:
   *
   *     1, 1, 1, 0.881, 0.4, 0.4, 0.4 …
   *
   * Un único carácter intermedio. No es un degradado ancho: es un cabezal de
   * lectura nítido que cruza letra por letra. Lo continuo es el recorrido de
   * ese carácter del suelo al blanco, no la anchura del borde.
   *
   * Contraintuitivo, y comprobado: con una rampa ancha (probé 30) la
   * diferencia entre caracteres vecinos es del 2%, el ojo no distingue el
   * avance y el bloque entero parece encenderse por palabras. Para que se lea
   * letra a letra el frente tiene que ser más duro, no más blando.
   *
   * El frente viaja hasta --n + --ramp y no hasta --n: si parase en --n, a los
   * últimos caracteres les faltaría el ancho del degradado para encenderse
   * del todo.
   *
   * El suelo de 0.45 no es un número elegido a ojo: blanco al 45% sobre la
   * tinta del vídeo pasa el mínimo AA para texto grande, que es lo que es este
   * (28px en móvil, 58px en escritorio). El carácter apagado sigue siendo
   * texto legible, no decoración.
   */
  .say__c {
    --ramp: 1;
    --front: calc(var(--p, 0) * (var(--n) + var(--ramp)));
    --t: clamp(0, calc((var(--front) - var(--i)) / var(--ramp)), 1);
    /*
     * Suavizado en los dos extremos (smoothstep: t²(3−2t)). Sin él la rampa es
     * recta y se notan los dos bordes del degradado, que es justo lo que hace
     * que el efecto parezca mecánico.
     */
    --lit: calc(var(--t) * var(--t) * (3 - 2 * var(--t)));
    opacity: calc(0.45 + 0.55 * var(--lit));
  }

  /* ------------------------------------------------------------------ */
  /* Reservas                                                            */
  /* ------------------------------------------------------------------ */

  /*
   * Sin JS o con movimiento reducido: los tres apilados, visibles y
   * encendidos. El texto no depende nunca de la animación.
   */
  html:not(.js) .say,
  html:not(.js) .say__pin {
    height: auto;
    position: static;
  }

  html:not(.js) .say__stack {
    gap: var(--space-l);
  }

  html:not(.js) .say__text {
    grid-area: auto;
  }

  html:not(.js) .say__line {
    transform: none;
    transition: none;
  }

  html:not(.js) .say__c {
    opacity: 1;
  }

  @media (prefers-reduced-motion: reduce) {
    .say,
    .say__pin {
      height: auto;
      position: static;
    }

    .say__pin {
      padding-block: var(--space-2xl);
    }

    .say__stack {
      gap: var(--space-l);
    }

    .say__text {
      grid-area: auto;
    }

    .say__mask {
      overflow: visible;
    }

    .say__line,
    .say__text.is-out .say__line {
      transform: none;
      transition: none;
    }

    .say__c {
      opacity: 1;
    }
  }
</style>

<script>
  const section = document.querySelector<HTMLElement>('[data-say]');

  if (section && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
    const items = Array.from(section.querySelectorAll<HTMLElement>('[data-statement]'));
    const count = section.querySelector<HTMLElement>('[data-count]');
    const total = items.length;

    /*
     * La lectura termina al 72% de cada tramo. El 28% restante deja la frase
     * encendida y quieta el tiempo suficiente para leerla antes de que salga;
     * sin ese margen el último carácter se enciende y desaparece a la vez.
     */
    const READ = 0.72;

    let current = -1;
    let raf = 0;

    const render = () => {
      raf = 0;

      const rect = section.getBoundingClientRect();
      const travel = section.offsetHeight - innerHeight;
      if (travel <= 0) return;

      /* 0 en cuanto el bloque se fija arriba, 1 al soltarse por abajo. */
      const progress = Math.min(1, Math.max(0, -rect.top / travel));

      const raw = progress * total;
      const index = Math.min(total - 1, Math.floor(raw));
      /* Avance dentro del enunciado vigente, estirado por READ. */
      const inner = Math.min(1, (raw - index) / READ);

      /* Avance de la sección entera, para la barra del filete. */
      section.style.setProperty('--prog', String(progress));

      if (index !== current) {
        current = index;
        items.forEach((el, i) => {
          el.classList.toggle('is-current', i === index);
          /* Los ya pasados se quedan arriba; los siguientes, abajo. */
          el.classList.toggle('is-out', i < index);
          if (i === index) el.removeAttribute('aria-hidden');
          else el.setAttribute('aria-hidden', 'true');

          /*
           * Se normaliza el encendido de los que no están en turno. El que
           * sale se va con todas las letras encendidas —acaba de leerse— y el
           * que espera llega apagado. Sin esto el saliente se marcha con el
           * medio encendido que tuviera y el gesto se ve sucio.
           */
          if (i !== index) el.style.setProperty('--p', i < index ? '1' : '0');
        });
        if (count) count.textContent = String(index + 1).padStart(2, '0');
      }

      /*
       * Sólo se escribe en el vigente. Los demás conservan su último valor,
       * que no se ve porque están fuera de la máscara — y al volver a entrar
       * se reescribe en el mismo fotograma.
       */
      items[index].style.setProperty('--p', String(inner));
    };

    const onScroll = () => {
      if (!raf) raf = requestAnimationFrame(render);
    };

    /* Sólo escucha mientras el bloque está en pantalla. */
    new IntersectionObserver(
      ([e]) => {
        if (e.isIntersecting) {
          addEventListener('scroll', onScroll, { passive: true });
          render();
        } else {
          removeEventListener('scroll', onScroll);
        }
      },
      { rootMargin: '20% 0px' },
    ).observe(section);

    addEventListener('resize', onScroll, { passive: true });
    render();
  }
</script>
