---
import { Picture } from 'astro:assets';
import Arrow from './Arrow.astro';
import { href, isExternal, formatDate, isoDate, type Article } from '../lib/newsroom';

interface Props {
  entry: Article;
  /**
   * Nivel del encabezado según dónde se use. En la home el destacado va
   * bajo el h2 "Newsroom", así que es h3; en /newsroom cuelga directo del
   * h1 y debe ser h2, o se salta un nivel.
   */
  as?: 'h2' | 'h3';
}
const { entry, as: Heading = 'h3' } = Astro.props;
const external = isExternal(entry);
const { image, imageAlt, category, date, title, excerpt } = entry.data;
---

<article class={`feat${image ? '' : ' feat--notext'}`} data-reveal>
  <a
    class="feat__link"
    href={href(entry)}
    target={external ? '_blank' : undefined}
    rel={external ? 'noopener noreferrer' : undefined}
  >
    {
      image && (
        <div class="feat__media">
          <Picture
            src={image}
            formats={['avif', 'webp']}
            widths={[480, 720, 1080]}
            sizes="(min-width: 64rem) 40vw, 92vw"
            alt={imageAlt ?? ''}
            loading="lazy"
            decoding="async"
            class="feat__img"
          />
        </div>
      )
    }

    <div class="feat__text">
      <p class="feat__meta t-eyebrow">
        <span class="feat__dot" aria-hidden="true"></span>
        {category}
        <span aria-hidden="true"> · </span>
        <time datetime={isoDate(date)}>{formatDate(date)}</time>
      </p>

      <Heading class="t-h3 feat__title">{title}</Heading>
      <p class="t-body feat__excerpt">{excerpt}</p>

      <p class="t-eyebrow feat__go">
        {external ? 'Leer en la fuente' : 'Leer artículo'}
        {external && <span class="sr-only"> (se abre en una pestaña nueva)</span>}
      </p>
    </div>

    {/* Misma esquina mordida que las tarjetas: el destacado es una tarjeta
        más, sólo que a lo ancho. */}
    <span class="feat__corner" aria-hidden="true"><Arrow /></span>
  </a>
</article>

<style>
  .feat {
    position: relative;
    background: var(--paper);
    border-radius: var(--radius-card);
  }

  .feat__link {
    display: grid;
    gap: var(--space-m);
    padding: var(--space-m);
    align-items: center;
  }

  @media (min-width: 64rem) {
    .feat__link {
      grid-template-columns: 1fr 1fr;
      gap: var(--space-l);
    }
    .feat--notext .feat__link {
      grid-template-columns: 1fr;
    }
  }

  /* El contenedor ya no recorta —el botón de esquina tiene que salirse—, así
     que el recorte de la imagen se hace aquí. */
  .feat__media {
    border-radius: var(--radius-img);
    overflow: clip;
    background: var(--ink);
  }

  .feat__img {
    width: 100%;
    height: 100%;
    aspect-ratio: 16 / 10;
    object-fit: cover;
    transition: transform var(--dur-mid) var(--ease-out);
  }

  .feat__link:hover .feat__img {
    transform: scale(1.02);
  }

  .feat__meta {
    display: flex;
    align-items: center;
    gap: 0.4ch;
    color: var(--graphite);
  }

  .feat__dot {
    width: 6px;
    height: 6px;
    margin-right: 0.4ch;
    background: var(--signal);
    border-radius: 50%;
    flex: none;
  }

  .feat__title {
    margin-top: var(--space-xs);
    color: var(--ink);
    max-width: 26ch;
  }

  .feat__excerpt {
    margin-top: var(--space-2xs);
    color: var(--graphite);
    max-width: 52ch;
    line-height: 1.5;
  }

  .feat__go {
    margin-top: var(--space-s);
    /* Deja libre la esquina del botón. */
    padding-right: var(--tap);
    color: var(--ink);
  }

  /* Ver ArticleCard: el anillo del color de la sección es la muesca. */
  .feat__corner {
    position: absolute;
    right: 0;
    bottom: 0;
    display: grid;
    place-items: center;
    width: var(--tap);
    height: var(--tap);
    background: var(--signal);
    color: var(--ink);
    border-radius: var(--radius-btn);
    box-shadow: 0 0 0 7px var(--notch, var(--frost));
    transition: transform var(--dur-fast) var(--ease-out);
  }

  .feat__link:hover .feat__corner {
    transform: translateX(3px);
  }

  @media (prefers-reduced-motion: reduce) {
    .feat__img {
      transition: none;
    }
    .feat__link:hover .feat__img {
      transform: none;
    }
    .feat__corner {
      transition: none;
    }
    .feat__link:hover .feat__corner {
      transform: none;
    }
  }
</style>
