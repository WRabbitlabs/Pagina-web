# Copiar a .env y rellenar. Nunca versionar .env.

# --- Formulario de contacto ---------------------------------------------
# Destinatario de los mensajes del formulario.
CONTACT_TO_EMAIL="contacto@wrabbit.ai"

# Proveedor de envío. Con `log` los mensajes solo se imprimen en consola,
# útil en desarrollo y para probar la validación sin enviar nada.
# Valores: log | resend
MAIL_PROVIDER="log"
RESEND_API_KEY=""
MAIL_FROM="WRabbit AI <no-reply@wrabbit.ai>"

# --- Anti-spam -----------------------------------------------------------
# Poner en "true" SOLO si hay un proxy de confianza delante (Cloudflare, un
# balanceador, nginx) que reescriba X-Forwarded-For. Sin proxy debe quedarse
# en falso: si no, cualquiera falsifica la cabecera y salta el limite.
TRUST_PROXY="false"

# Ventana de rate limiting por IP.
RATE_LIMIT_MAX="5"
RATE_LIMIT_WINDOW_MS="900000"

# --- Sitio ---------------------------------------------------------------
# Debe coincidir con SITE_URL en astro.config.mjs.
PUBLIC_SITE_URL="https://wrabbit.ai"
