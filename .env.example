# Copiar a .env y rellenar. Nunca versionar .env.

# --- Sitio ---------------------------------------------------------------
# Debe coincidir con SITE_URL en astro.config.mjs.
PUBLIC_SITE_URL="https://wrailabs.com"

# --- Formulario de contacto ----------------------------------------------
# La direccion del servicio de formularios (Formspree, Basin). El sitio es
# estatico y no tiene endpoint propio: sin esta variable, /contact enseña los
# canales directos en vez de un formulario que no envia a ninguna parte.
#
# En produccion va como variable del repositorio:
#   Settings > Secrets and variables > Actions > Variables
PUBLIC_FORM_ENDPOINT=""
